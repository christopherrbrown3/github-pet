    "alphaRule": "every drawn alpha = token alpha * layer alphaScale * burst envelope (fade-in opacity; 1 outside the fade-in)"
  },
  "accessibility": {
    "hoverTopLine": "GitHub incident: <name>",
    "label": "N items, 1 active GitHub incident",
    "countUnaffected": "badge counts actionable items only"
  }
}
